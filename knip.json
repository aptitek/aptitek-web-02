{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.{astro,md,mdx,ts,js}",
    "src/tokens/**",
    "src/components/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{astro,ts,tsx,js,jsx}",
    "stories/**/*.{ts,tsx,mdx}",
    "scripts/**/*.{ts,js,mjs}",
    "playwright/**/*.{ts,js}"
  ],
  "ignoreDependencies": ["@astrojs/check"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off",
    "exports": "off",
    "types": "off"
  }
}
