{
  "name": "aptitek-02",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "preview": "astro preview",
    "lint": "wireit",
    "lint:eslint": "wireit",
    "lint:prettier": "wireit",
    "lint:fix": "eslint --fix --cache --cache-strategy content . && prettier --write --cache --cache-strategy content .",
    "typecheck": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:e2e": "wireit",
    "test:watch": "vitest",
    "test:coverage": "wireit",
    "knip": "wireit",
    "knip:fix": "knip --fix --allow-remove-files",
    "prepare": "husky"
  },
  "wireit": {
    "dev": {
      "command": "astro dev",
      "service": true,
      "env": {
        "ASTRO_DEV_BACKGROUND": "false"
      }
    },
    "typecheck": {
      "command": "astro check && tsc --noEmit",
      "files": [
        "src/**/*",
        "astro.config.mjs",
        "tsconfig.json",
        "package.json"
      ],
      "output": []
    },
    "lint:eslint": {
      "command": "eslint --cache --cache-strategy content .",
      "files": [
        "src/**/*",
        "scripts/**/*",
        "playwright/**/*",
        "eslint.config.js",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        ".eslintcache"
      ]
    },
    "lint:prettier": {
      "command": "prettier --check --cache --cache-strategy content .",
      "files": [
        "src/**/*",
        "scripts/**/*",
        "playwright/**/*",
        "*.{js,mjs,json,md}",
        ".prettierrc.mjs",
        ".prettierignore"
      ],
      "output": [
        ".prettiercache"
      ]
    },
    "lint": {
      "dependencies": [
        "lint:eslint",
        "lint:prettier"
      ]
    },
    "test:unit": {
      "command": "vitest run",
      "files": [
        "src/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": []
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "files": [
        "src/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "coverage/**/*"
      ]
    },
    "test:e2e": {
      "command": "playwright test",
      "files": [
        "playwright/**/*",
        "playwright.config.ts",
        "src/**/*",
        "astro.config.mjs",
        "package.json",
        "tsconfig.json"
      ],
      "output": [
        "playwright-report/**/*",
        "test-results/**/*"
      ]
    },
    "test": {
      "dependencies": [
        "test:unit",
        "test:e2e"
      ]
    },
    "build": {
      "command": "astro build",
      "dependencies": [
        "typecheck",
        "lint",
        "test"
      ],
      "files": [
        "src/**/*",
        "public/**/*",
        "astro.config.mjs",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**/*"
      ]
    },
    "knip": {
      "command": "knip",
      "dependencies": [
        "typecheck"
      ],
      "files": [
        "src/**/*",
        "scripts/**/*",
        "playwright/**/*",
        "knip.json",
        "package.json",
        "tsconfig.json"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@astrojs/react": "^4.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "astro": "^7.3.2",
    "framer-motion": "^13.2.0",
    "material-shapes-ts": "^0.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "playwright": "latest",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wireit": "^0.14.13"
  }
}
