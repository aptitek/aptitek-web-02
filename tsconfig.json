{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "stories/**/*",
    "playwright/**/*",
    "scripts/**/*",
    "*.ts",
    "*.js",
    "*.mjs"
  ],
  "exclude": ["dist", "storybook-static", "node_modules", ".astro", "coverage"]
}
